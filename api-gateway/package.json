{
  "name": "luontotieto-api-gateway",
  "version": "0.0.1",
  "private": true,
  "description": "API gateway for luontotieto",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./build ./dist",
    "build": "yarn clean && yarn install && tsc --build .",
    "lint": "oxfmt -c ../.oxfmtrc.json --check && oxlint",
    "lint:fix": "oxfmt -c ../.oxfmtrc.json && oxlint --fix",
    "type-check": "tsc --noEmit",
    "dev": "tsc --build . && concurrently --prefix '[{name}]' --names 'tsc,node' 'tsc --build --preserveWatchOutput -w .' 'NODE_ENV=local node --watch-path=./dist dist/index.js'"
  },
  "dependencies": {
    "@node-saml/node-saml": "5.1.0",
    "@node-saml/passport-saml": "5.1.1",
    "axios": "1.20.0",
    "connect-redis": "10.0.0",
    "cookie-parser": "1.4.7",
    "csurf": "1.11.0",
    "date-fns": "4.4.0",
    "express": "5.3.0",
    "express-http-proxy": "2.1.2",
    "express-session": "1.19.0",
    "fast-xml-parser": "5.11.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.18.1",
    "make-error-cause": "2.3.0",
    "nocache": "4.0.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "query-string": "10.0.0",
    "redis": "6.3.0",
    "source-map-support": "0.5.21",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/csurf": "1.11.5",
    "@types/express-http-proxy": "1.6.7",
    "@types/express-session": "1.19.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/passport-strategy": "0.2.38",
    "@types/pino-http": "6.1.0",
    "@types/pino-pretty": "5.0.0",
    "@types/pino-std-serializers": "4.0.0",
    "@types/source-map-support": "0.5.10",
    "concurrently": "10.0.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "shell-quote": "1.12.0"
  },
  "engines": {
    "node": ">= 20.11.0"
  },
  "packageManager": "yarn@4.18.1"
}

{
  "name": "luontotieto-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Frontend for luontotieto",
  "scripts": {
    "clean": "rm -rf dist node_modules/.cache",
    "dev": "concurrently -n tsc,esbuild -c blue,green 'yarn type-check:watch' 'yarn build:serve'",
    "lint": "oxfmt -c ../.oxfmtrc.json --check && oxlint",
    "lint:fix": "oxfmt -c ../.oxfmtrc.json && oxlint --fix",
    "type-check": "tsc --build --force .",
    "type-check:watch": "yarn type-check --watch --preserveWatchOutput",
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "build:serve": "node build.js --dev --watch --serve"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@react-spring/web": "10.1.2",
    "@tanstack/react-query": "5.104.2",
    "@types/react": "19.3.0",
    "babel-plugin-styled-components": "2.3.0",
    "classnames": "2.5.1",
    "core-js": "3.50.0",
    "date-fns": "4.4.0",
    "file-saver": "2.0.5",
    "lodash": "4.18.1",
    "polished": "4.3.1",
    "react": "19.3.0",
    "react-csv": "2.2.2",
    "react-dom": "19.3.0",
    "react-focus-lock": "2.13.7",
    "react-router-dom": "7.18.4",
    "react-tag-autocomplete": "7.5.1",
    "react-textarea-autosize": "8.5.9",
    "styled-components": "6.5.3",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@types/file-saver": "2.0.7",
    "@types/lodash": "4.17.26",
    "@types/node": "24.19.2",
    "@types/react-csv": "1.1.10",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@types/styled-components": "5.1.36",
    "@types/uuid": "11.0.0",
    "axios": "1.20.0",
    "babel-loader": "10.1.1",
    "concurrently": "10.0.6",
    "css-loader": "7.1.5",
    "esbuild": "0.28.2",
    "eslint-plugin-lodash": "8.1.0",
    "express": "5.3.0",
    "express-http-proxy": "2.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "8.5.29",
    "postcss-loader": "8.2.1",
    "postcss-preset-env": "11.6.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "yargs": "18.2.0"
  },
  "resolutions": {
    "minimatch@9.0.3": "10.2.6",
    "shell-quote": "1.12.0"
  },
  "engines": {
    "node": ">= 20.11.0"
  },
  "packageManager": "yarn@4.18.1",
  "postcss": {
    "plugins": {
      "postcss-preset-env": true
    }
  }
}
